# Grafana Alert Agent — full .env reference (copy to .env and fill in).
# All vars are prefixed GAA_. Anything marked [REQUIRED] must be set for that feature.
# .env is gitignored; .env.example is committed.

# =====================================================================
# Grafana (private subnet, reached over your OpenVPN tunnel)
# =====================================================================
GAA_GRAFANA_URL=https://grafana10.private.devopsinstitute.id
GAA_GRAFANA_SA_TOKEN=glsa_xxxxxxxxxxxxxxxxxxxxxxxx   # [REQUIRED] Viewer-scoped service-account token
GAA_GRAFANA_CA_CERT=/Users/you/myca/ca.crt          # [REQUIRED unless TLS_INSECURE] internal CA bundle
GAA_TLS_INSECURE=false                               # true skips TLS verify (discouraged)

# =====================================================================
# Discord
# =====================================================================
GAA_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN  # [REQUIRED for alerts] one-way delivery
GAA_DISCORD_BOT_TOKEN=                               # [REQUIRED for the bot] two-way chat (gateway)
GAA_DISCORD_CHANNEL_ID=0                             # optional: only respond in this channel (0 = anywhere)

# =====================================================================
# LLM provider (analysis + chat)
# =====================================================================
GAA_LLM_PROVIDER=bedrock                             # "bedrock" (bearer key) or "anthropic"
GAA_CHAT_PROVIDER=bedrock                            # model for the chat agent (LangChain)

# Bedrock (bearer API key — no IAM creds needed)
GAA_BEDROCK_REGION=ap-southeast-3
GAA_BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
GAA_BEDROCK_API_KEY=                                 # [REQUIRED when provider=bedrock]

# Direct Anthropic API (only used when *_PROVIDER=anthropic)
GAA_ANTHROPIC_API_KEY=
GAA_CLAUDE_MODEL=claude-sonnet-4-6

# =====================================================================
# MCP — read-only Grafana tools for the chat agent (query_prometheus, loki, Sift…)
# Without this the bot can ONLY see incidents — it can't query live metrics/logs,
# which is why "is p99 high?" got a deflection instead of a real number.
# =====================================================================
GAA_MCP_GRAFANA_BIN=.tools/mcp-grafana               # [REQUIRED for live metric/log/trace queries]
                                                     # path to the mcp-grafana binary (or put it on PATH)

# =====================================================================
# Dashboard / screenshots (for alert panels + !shot)
# =====================================================================
GAA_DASHBOARD_UID=adrwn4x                            # auto-discovered from slug if blank
GAA_DASHBOARD_SLUG=url-shortener-e28094-group10-logs

# =====================================================================
# Behaviour
# =====================================================================
GAA_POLL_INTERVAL_SECONDS=30
GAA_DEFAULT_ENV=prod
GAA_RULES_PATH=config/rules.yaml
GAA_STATE_DB=.gaa/state.db
GAA_LOG_LEVEL=INFO
