# Grafana Alert Agent — example environment (copy to .env at the repo root and fill in)
# Names only; never commit real secret values.

# --- Grafana (private subnet, reached over the OpenVPN tunnel) ---
GAA_GRAFANA_URL=https://grafana.example.internal
GAA_GRAFANA_SA_TOKEN=glsa_xxxxxxxxxxxxxxxxxxxxxxxxxxxx        # Viewer-scoped service account token
GAA_GRAFANA_CA_CERT=/path/to/internal/ca.crt                  # internal CA bundle for TLS verification
GAA_TLS_INSECURE=false                                        # true skips TLS verify (discouraged)

# --- Discord ---
GAA_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN   # one-way alert delivery
GAA_DISCORD_BOT_TOKEN=                                        # bot token for two-way chat (gateway)
GAA_DISCORD_CHANNEL_ID=0                                      # optional: restrict bot to one channel

# --- LLM provider: "bedrock" (bearer key) or "anthropic" (direct API) ---
GAA_LLM_PROVIDER=bedrock
GAA_CHAT_PROVIDER=bedrock                                     # model for the chat agent (LangChain)
GAA_BEDROCK_REGION=ap-southeast-3
GAA_BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
GAA_BEDROCK_API_KEY=                                          # required when provider=bedrock
GAA_ANTHROPIC_API_KEY=                                        # required when provider=anthropic
GAA_CLAUDE_MODEL=claude-sonnet-4-6

# --- MCP (Grafana) — read-only mcp-grafana binary the chat agent uses ---
GAA_MCP_GRAFANA_BIN=mcp-grafana                              # path to the binary (or e.g. .tools/mcp-grafana)

# --- Dashboard / screenshots ---
GAA_DASHBOARD_UID=                                            # auto-discovered if blank
GAA_DASHBOARD_SLUG=url-shortener-public

# --- Behaviour ---
GAA_POLL_INTERVAL_SECONDS=30
GAA_DEFAULT_ENV=prod
GAA_RULES_PATH=config/rules.yaml
GAA_STATE_DB=.gaa/state.db
GAA_LOG_LEVEL=INFO
